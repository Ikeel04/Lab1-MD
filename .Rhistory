movies <- read.csv("movies_2026.csv", stringsAsFactors = FALSE)
library(tidyverse)
library(tidyverse)
library(lubridate)
library(skimr)
library(ggpubr)
library(nortest)
library(tidyr)
top_budget <- movies[order(movies$budget, decreasing=TRUE), c("title", "budget")]
head(top_budget, n = 10)
top_votes <- movies[order(movies$voteCount, decreasing=TRUE), c('title', 'voteCount')]
head(top_votes, n = 1)
head(top_votes, n = 1)
top20 <- movies[order(movies$voteAvg, decreasing = TRUE), ]
top20_directors <- unique(top20$director[1:20])
top20_directors
top20 <- movies[movies$voteCount >= 100, ]
top20 <- top20[order(top20$voteAvg, decreasing = TRUE), ]
top20_clean <- top20[1:20, c("title", "director", "voteAvg")]
top20_clean <- top20_clean[top20_clean$director != "", ]
top20_clean
