top20 <- movies[order(movies$voteAvg, decreasing = TRUE), ]
top20 <- top20[1:20, ]
top20 <- top20[top20$director != "", ]
directores_sep <- unlist(strsplit(top20$director, "\\|"))
directores_sep <- unique(trimws(directores_sep))
directores_sep
data.frame(director = directores_sep)
top20 <- movies[order(movies$voteAvg, decreasing = TRUE), ]
top20 <- top20[1:20, ]
top20 <- top20[top20$director != "", ]
directores_sep <- strsplit(top20$director, "\\|")
resultado <- data.frame(
director = trimws(unlist(directores_sep)),
title = rep(top20$title, sapply(directores_sep, length)),
voteAvg = rep(top20$voteAvg, sapply(directores_sep, length))
)
resultado
top20 <- movies[movies$voteCount >= 100, ]
top20 <- top20[order(top20$voteAvg, decreasing = TRUE), ]
top20 <- top20[1:20, ]
top20 <- top20[top20$director != "", ]
directores_sep <- strsplit(top20$director, "\\|")
resultado <- data.frame(
director = trimws(unlist(directores_sep)),
title = rep(top20$title, sapply(directores_sep, length)),
voteAvg = rep(top20$voteAvg, sapply(directores_sep, length)),
voteCount = rep(top20$voteCount, sapply(directores_sep, length))
)
resultado <- unique(resultado)
resultado <- resultado[order(resultado$voteAvg, decreasing = TRUE), ]
resultado
install.packages(tidyverse)
install.packages("tidyverse")
install.packages("lubridate")
install.packages("skimr")
movies_month <- movies %>%
filter(!is.na(releaseDate), !is.na(revenue), revenue > 0) %>%
mutate(
releaseDate = ymd(releaseDate),
month = month(releaseDate, label = TRUE, abbr = TRUE)
)
movies_month <- movies %>%
filter(!is.na(releaseDate), !is.na(revenue), revenue > 0) %>%
mutate(
releaseDate = ymd(releaseDate),
month = month(releaseDate, label = TRUE, abbr = TRUE)
)
movies$revenue <- as.numeric(movies$revenue)
movies_month <- movies %>%
filter(!is.na(releaseDate), !is.na(revenue), revenue > 0) %>%
mutate(
releaseDate = ymd(releaseDate),
month = month(releaseDate, label = TRUE, abbr = TRUE)
)
revenue_month <- movies_month %>%
group_by(month) %>%
summarise(
ingreso_promedio = mean(revenue, na.rm = TRUE),
peliculas = n()
) %>%
arrange(month)
revenue_month
ggplot(revenue_month, aes(x = month, y = ingreso_promedio)) +
geom_col() +
labs(
title = "Ingreso promedio por mes de lanzamiento",
x = "Mes",
y = "Ingreso promedio"
) +
theme_minimal()
revenue_month %>%
arrange(desc(ingreso_promedio)) %>%
head(1)
movies$revenue <- as.numeric(movies$revenue)
movies_month <- movies %>%
filter(!is.na(releaseDate), !is.na(revenue), revenue > 0) %>%
mutate(
releaseDate = ymd(releaseDate),
