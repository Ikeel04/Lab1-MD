names(movies)
movies <- movies %>%
mutate(revenue = as.numeric(revenue))
movies_month <- movies %>%
filter(!is.na(releaseDate) & !is.na(revenue) & revenue > 0) %>%
mutate(
releaseDate = ymd(releaseDate),
month = month(releaseDate, label = TRUE, abbr = TRUE)
)
movies_month <- movies %>%
mutate(
releaseDate = ymd(releaseDate),
revenue     = as.numeric(revenue)
) %>%
filter(
!is.na(releaseDate),
!is.na(revenue),
revenue > 0
) %>%
mutate(
month = month(releaseDate, label = TRUE, abbr = TRUE)
)
movies_month <- movies %>%
mutate(
releaseDate = ymd(releaseDate),
revenue     = as.numeric(revenue)
) %>%
filter(
!is.na(releaseDate),
!is.na(revenue),
revenue > 0
) %>%
mutate(
month = month(releaseDate, label = TRUE, abbr = TRUE)
)
